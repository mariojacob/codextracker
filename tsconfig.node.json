{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-main",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"],
    "noEmitOnError": true
  },
  "include": ["src/main", "src/preload", "src/shared"],
  "exclude": ["node_modules", "src/renderer"]
}